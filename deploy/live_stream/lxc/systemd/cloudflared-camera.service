[Unit]
Description=cloudflared Access TCP bridge to the hut camera (localhost:18554)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/relay/relay.env
ExecStart=/usr/bin/cloudflared access tcp --hostname ${CAM_HOSTNAME} --url localhost:18554 --service-token-id ${CAM_ACCESS_ID} --service-token-secret ${CAM_ACCESS_SECRET}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
