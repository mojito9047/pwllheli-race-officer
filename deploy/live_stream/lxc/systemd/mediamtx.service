[Unit]
Description=MediaMTX (hut live-stream relay)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/relay/relay.env
WorkingDirectory=/opt/relay
ExecStart=/opt/relay/mediamtx /opt/relay/mediamtx.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
