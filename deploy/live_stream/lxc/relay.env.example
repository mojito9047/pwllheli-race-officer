# /etc/relay/relay.env — read by the mediamtx + cloudflared systemd units.
# Copy is created by setup.sh; edit the real file at /etc/relay/relay.env.

# Full camera RTSP via the LOCAL cloudflared Access bridge (localhost:18554).
CAMERA_URL=rtsp://viewuser:viewpass@localhost:18554/Streaming/Channels/102
MANIFEST_URL=https://pro.pwllhelisailingclub.org/api/branding/live
CAMERA_FPS=15

# Burn the hut's TWD/TWS/gust across the top of the stream. Off unless set to 1.
# The endpoint is public, so no credentials travel to the relay.
WIND_OVERLAY=0
WIND_URL=https://pro.pwllhelisailingclub.org/api/weather/current
# Text height as a fraction of the frame; 0.0225 is ~24px at 1080 lines.
#WIND_FONT_SCALE=0.0225
# Outlined text by default. Set to 1 for a solid panel behind it instead.
#WIND_BOX=0

# Cloudflare dashboard-managed tunnel token.
# The tunnel's Public Hostname pro.pwllhelisailingclub.org must point to http://localhost:80
TUNNEL_TOKEN=

# Access service token authorising this relay to reach the hut app on
# hut-origin. That hostname is public, so without an Access policy on it anyone
# can reach the app directly and skip this relay, and every WAF or rate-limit
# rule scoped to pro. with it. Caddy sends these two as CF-Access-Client-Id and
# CF-Access-Client-Secret; the drop-in at
# /etc/systemd/system/caddy.service.d/relay-env.conf is what lets Caddy read
# them, and Caddy needs a restart (not a reload) after they change.
HUT_ACCESS_ID=
HUT_ACCESS_SECRET=

# The hut camera exposed as a Cloudflare Access TCP hostname (README steps 0-1),
# plus an Access service token authorising this relay to reach it.
CAM_HOSTNAME=hut-cam.pwllhelisailingclub.org
CAM_ACCESS_ID=
CAM_ACCESS_SECRET=
