# Copy to .env and fill in. docker compose reads it automatically.

# Cloudflare dashboard-managed tunnel token for pro.pwllhelisailingclub.org.
# Create the tunnel in Zero Trust -> Networks -> Tunnels, add a Public Hostname
# pro.pwllhelisailingclub.org -> Type HTTP -> URL http://caddy:80, then paste the token here.
TUNNEL_TOKEN=

# The hut camera exposed as a Cloudflare Access TCP hostname (README steps 1-2),
# plus an Access service token that authorises this relay to reach it.
CAM_HOSTNAME=hut-cam.pwllhelisailingclub.org
CAM_ACCESS_ID=
CAM_ACCESS_SECRET=

# Least-privilege camera (live-view only) credentials for the RTSP sub-stream.
CAM_USER=viewuser
CAM_PASS=viewpass

# The hut app's public branding manifest (used to burn in the current logos).
MANIFEST_URL=https://pro.pwllhelisailingclub.org/api/branding/live

# Camera sub-stream frame rate (used for -g to keep latency low).
CAMERA_FPS=15
