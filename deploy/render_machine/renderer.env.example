# The render machine's settings. Copy to renderer.env and fill in.
#
#   Linux:    /etc/pwllheli/renderer.env   (root-owned, chmod 600)
#   Windows:  deploy\render_machine\renderer.env, loaded by run_renderer.ps1
#
# It holds an R2 secret key, so it is not something to commit or to email.

# --- The bucket -------------------------------------------------------------
# These five MUST match Settings -> "Cloud storage (Cloudflare R2)" in
# the race app. The film lands beside the race clips it is made from, and the
# app reads the job and status objects out of the same bucket. A renderer
# pointed at a different bucket sits there seeing no work, for ever.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public address, e.g. https://videos.yourclub.org
R2_PUBLIC_BASE_URL=

# --- Map tiles --------------------------------------------------------------
# The coastline and the satellite imagery. The first job for a new stretch of
# water fetches what it needs and caches it on this machine (runtime/replay3d),
# so later jobs over the same course need no Mapbox at all. Without a token the
# film still renders; it just has sea, marks and boats and no land.
MAPBOX_TOKEN=

# --- Branding (optional) ----------------------------------------------------
# A job names the club's logo list itself when the hut has its public address
# set (Settings -> Web server). For a hut that does not, this is where the logos
# come from. Left empty, such a film carries no logos; there is no built-in club.
#   e.g. https://pro.pwllhelisailingclub.org/api/branding/live
# MANIFEST_URL=

# --- Blender ----------------------------------------------------------------
# Left empty, the renderer looks for blender on PATH. Set it if you have
# several installed, or if it is not on PATH.
#   Linux:    /opt/blender/blender
#   Windows:  C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
BLENDER_BIN=

# --- How hard to work -------------------------------------------------------
# Blender instances rendering frames at once. Each wants roughly 4 GB and a
# core; two is right for a 6-core desktop, four for a 16-core workstation.
RENDER_WORKERS=2

# Commissioning: render only these frames, so a wrong key or a missing font
# shows up in ten minutes instead of two hours. Leave it EMPTY in service.
# RENDER_FRAME_RANGE=1-120
